# URL pública del sitio (usada en metadata y links absolutos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL interna del backend NestJS (kora_api) — SOLO server-side, nunca NEXT_PUBLIC_
BACKEND_URL=http://localhost:4000

# Token server-to-server para autenticar el BFF contra el backend, si aplica
BACKEND_TOKEN=
